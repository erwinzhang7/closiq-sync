{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "watchalong-rooms",
  "main": "src/index.js",
  // Pinned to what the locally installed workerd supports; bumping this
  // requires bumping wrangler first or `dev --local` refuses to start.
  "compatibility_date": "2026-05-28",
  "observability": { "enabled": true },
  // 8787 is safari-mcp's on this machine; do not take it back.
  "dev": { "port": 8799 },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [
    {
      "tag": "v1",
      // new_sqlite_classes rather than new_classes: SQLite-backed DOs are the
      // current default and are required for the free plan.
      "new_sqlite_classes": ["Room"]
    }
  ]
}
