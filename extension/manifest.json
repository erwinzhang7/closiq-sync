{
  "manifest_version": 3,
  "name": "Watchalong",
  "version": "1.0",
  "description": "Watch videos in sync with someone else. Play, pause and seek together on any site, with gentle speed nudges that close small gaps invisibly.",

  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["*://*/*"],

  "background": {
    "scripts": ["api.js", "shared.js", "background.js"]
  },

  "action": {
    "default_title": "Watchalong",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/toolbar-16.png",
      "19": "images/toolbar-19.png",
      "32": "images/toolbar-32.png",
      "38": "images/toolbar-38.png",
      "64": "images/toolbar-64.png"
    }
  },

  "icons": {
    "48": "images/icon-48.png",
    "96": "images/icon-96.png",
    "128": "images/icon-128.png",
    "256": "images/icon-256.png",
    "512": "images/icon-512.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["api.js", "shared.js", "media.js", "sync.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
